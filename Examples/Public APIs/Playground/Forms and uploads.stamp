# With a form Content-Type, a body of "name = value" lines is sent as a form.
# "name = < ./path" attaches a file, relative to this .stamp file.

### Multipart upload
# Pinned to httpbin whatever env says, because the last two assertions read the
# way httpbin reports an uploaded file: text inline, binary as a data URI.
POST {{httpbin}}/post
Content-Type: multipart/form-data

title = Greetings from {{fake.city}}
author = {{person(3).name}}
note = < ./files/hello.txt
picture = < ./files/stamp.png

> assert status == 200
> assert body.form.author == person(3).name
> assert body.files.note contains "Stampdrill"
> assert body.files.picture matches "^data:image/png;base64,"

### URL-encoded form
POST {{echo}}/post
Content-Type: application/x-www-form-urlencoded

username = {{username}}
remember = true
redirect = /home?tab=1

> assert body.form.redirect contains "/home?tab=1"
> assert body.form.username contains username

### Raw file upload
PUT {{echo}}/put
Content-Type: text/plain

< ./files/hello.txt

> assert body.data contains "multipart form"
