# httpbin.org answers with what it received, which makes it a good place
# to try out headers, auth and redirects.

### Echo
POST {{httpbin}}/anything?source=stampdrill
X-Trace: {{uuid()}}
# X-Debug: on

{ "name": "{{fake.name}}", "sentAt": "{{now()}}" }

> assert status == 200
> assert body.args.source == "stampdrill"
> assert body.json.name != null
> assert body.headers["X-Trace"] != null

### Basic auth
@auth basic user passwd
GET {{httpbin}}/basic-auth/user/passwd

> assert status == 200
> assert body.authenticated == true

### Bearer token
@auth bearer {{secret("not-a-real-token")}}
GET {{httpbin}}/bearer

> assert body.token == "not-a-real-token"

### API key in the query
@auth apikey api_key {{sha256("stampdrill")}} query
GET {{httpbin}}/get

> assert body.args.api_key == sha256("stampdrill")

### Redirect, not followed
@no-redirect
GET {{httpbin}}/redirect-to?url=/get&status_code=302

> assert status == 302
> assert headers.location == "/get"

### Slow response
@timeout 5s
GET {{httpbin}}/delay/1

> assert time >= 1000

### Teapot
GET {{httpbin}}/status/418

> assert status == 418
